{
  "name": "mars-outpost-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:sim && npm run test:world && npm run test:globe && npm run test:flow && npm run test:crops && npm run test:habitat && npm run test:power && npm run test:field && npm run test:balance",
    "test:sim": "esbuild test/sim.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/simtest.mjs --log-level=error && node node_modules/.tmp/simtest.mjs",
    "test:world": "esbuild test/world.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/worldtest.mjs --log-level=error && node node_modules/.tmp/worldtest.mjs",
    "test:globe": "esbuild test/globe.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/globetest.mjs --log-level=error && node node_modules/.tmp/globetest.mjs",
    "test:flow": "esbuild test/flow.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/flowtest.mjs --log-level=error && node node_modules/.tmp/flowtest.mjs",
    "test:balance": "esbuild test/balance.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/baltest.mjs --log-level=error && node node_modules/.tmp/baltest.mjs",
    "test:crops": "esbuild test/crops.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/croptest.mjs --log-level=error && node node_modules/.tmp/croptest.mjs",
    "test:habitat": "esbuild test/habitat.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/habtest.mjs --log-level=error && node node_modules/.tmp/habtest.mjs",
    "test:power": "esbuild test/power.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/pwrtest.mjs --log-level=error && node node_modules/.tmp/pwrtest.mjs",
    "test:field": "esbuild test/field.test.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/fieldtest.mjs --log-level=error && node node_modules/.tmp/fieldtest.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "postprocessing": "^6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
